VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Push notifications — generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY

# Needed by the Supabase Edge Functions: daily-reminders and send-push
# (set with `supabase secrets set`, not in this file)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# ANTHROPIC_API_KEY is no longer required — word definitions/translations
# now use free public APIs (dictionaryapi.dev + MyMemory).
